FROM node:20-alpine

# Install Python, yt-dlp, and ffmpeg system packages
RUN apk add --no-cache \
    python3 \
    py3-pip \
    ffmpeg \
    ca-certificates

# Install yt-dlp globally
RUN python3 -m pip install --no-cache-dir --break-system-packages yt-dlp

WORKDIR /app

COPY backend/package*.json ./
RUN npm ci

COPY backend/ ./

RUN npm run build

EXPOSE 5000

CMD ["node", "dist/server.js"]
